+++ b/Controllers/UsersController.cs
@@ -0,0 +1,293 @@
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.AspNetCore.Mvc;
+using Microsoft.EntityFrameworkCore;
+using NeverBeen.API.Common;
+using NeverBeen.API.Data;
+using NeverBeen.API.Dtos;
+using NeverBeen.API.Entities;
+
+namespace NeverBeen.API.Controllers;
+
+/// <summary>
+/// The member directory: name search for the community search box and the public
+/// profile of any member (by numeric id or by the 20-digit unique id used in
+/// profile URLs, e.g. /profile?id=89201534010000000007).
+/// </summary>
+[Route("api/users")]
+[ApiController]
+[Authorize]
+public class UsersController : ControllerBase
+{
+    private readonly AppDbContext _db;
+
+    public UsersController(AppDbContext db)
+    {
+        _db = db;
+    }
+
+    /// <summary>
+    /// Searches Active members by name (first, last or full name); city, country and
+    /// profession match too so the community search box works like the guest tour's.
+    /// Hidden members: the signed-in member themself, members who switched off their
+    /// search visibility (UserSettings.SearchVisibility) and members blocked in either
+    /// direction. Name hits are ranked before city / country / profession hits.
+    /// </summary>
+    [HttpGet("search")]
+    public async Task<ActionResult<List<UserSearchResultDto>>> Search(
+        [FromQuery] string? query,
+        [FromQuery] int limit = 20,
+        CancellationToken cancellationToken = default)
+    {
+        var myId = User.GetUserId();
+        var needle = (query ?? string.Empty).Trim();
+        if (needle.Length == 0)
+            return Ok(new List<UserSearchResultDto>());
+        if (needle.Length > 100)
+            needle = needle[..100];
+        if (limit < 1) limit = 1;
+        if (limit > 50) limit = 50;
+
+        var pattern = $"%{needle}%";
+
+        // Blocked travelers are invisible to each other everywhere in the community —
+        // including search (same rule as the Journey feed and the companions list).
+        var blockedIds = await BlockedIds(myId, cancellationToken);
+
+        var candidates = await _db.Users.AsNoTracking()
+            .Include(u => u.Country)
+            .Include(u => u.City)
+            .Include(u => u.Settings)
+            .Where(u => u.Status == UserProfileStatus.Active && u.Id != myId)
+            .Where(u => !blockedIds.Contains(u.Id))
+            .Where(u => u.Settings == null || u.Settings.SearchVisibility)
+            .Where(u =>
+                EF.Functions.ILike(u.FullName ?? string.Empty, pattern) ||
+                EF.Functions.ILike(u.FirstName ?? string.Empty, pattern) ||
+                EF.Functions.ILike(u.LastName ?? string.Empty, pattern) ||
+                (u.City != null && EF.Functions.ILike(u.City.Name, pattern)) ||
+                (u.Country != null && EF.Functions.ILike(u.Country.Name, pattern)) ||
+                EF.Functions.ILike(u.Profession ?? string.Empty, pattern))
+            .OrderBy(u => u.Id)
+            .Take(limit * 3)
+            .ToListAsync(cancellationToken);
+
+        // Name hits first (that is what the search box types), then everything else.
+        var nameHits = candidates
+            .Where(u => Matches(u.FullName, needle) || Matches(u.FirstName, needle) || Matches(u.LastName, needle))
+            .ToList();
+        var otherHits = candidates.Except(nameHits).ToList();
+        var ranked = nameHits.Concat(otherHits).Take(limit).ToList();
+        if (ranked.Count == 0)
+            return Ok(new List<UserSearchResultDto>());
+
+        var rankedIds = ranked.Select(u => u.Id).ToList();
+
+        // Relationship of the signed-in member to every hit — one query each.
+        var pairs = await _db.Companionships.AsNoTracking()
+            .Where(c => (c.UserId == myId && rankedIds.Contains(c.CompanionId)) ||
+                        (c.CompanionId == myId && rankedIds.Contains(c.UserId)))
+            .ToListAsync(cancellationToken);
+        var follows = await _db.Follows.AsNoTracking()
+            .Where(f => f.FollowerId == myId && rankedIds.Contains(f.FolloweeId))
+            .Select(f => f.FolloweeId)
+            .ToListAsync(cancellationToken);
+
+        // Mutual companions: my connected ids intersected with each hit's connected ids.
+        var mine = await ConnectedCompanionIds(myId, cancellationToken);
+        var theirRows = await _db.Companionships.AsNoTracking()
+            .Where(c => c.Status == CompanionshipStatus.Connected &&
+                        (rankedIds.Contains(c.UserId) || rankedIds.Contains(c.CompanionId)))
+            .ToListAsync(cancellationToken);
+        var theirs = rankedIds.ToDictionary(
+            id => id,
+            id => theirRows
+                .Where(c => c.UserId == id || c.CompanionId == id)
+                .Select(c => c.UserId == id ? c.CompanionId : c.UserId)
+                .ToHashSet());
+
+        var result = new List<UserSearchResultDto>();
+        foreach (var user in ranked)
+        {
+            var row = pairs.FirstOrDefault(c =>
+                (c.UserId == myId && c.CompanionId == user.Id) ||
+                (c.CompanionId == myId && c.UserId == user.Id));
+
+            result.Add(new UserSearchResultDto
+            {
+                Id = user.Id,
+                UniqueId = user.UniqueId ?? UserProfileStatus.GenerateUniqueId(user.Id),
+                FullName = user.FullName ?? string.Empty,
+                ProfilePhotoUrl = user.ProfilePhotoData != null
+                    ? $"/api/profile/{user.Id}/photo"
+                    : user.ProfilePhotoUrl ?? user.ExternalProfilePictureUrl ?? string.Empty,
+                Country = user.Country?.Name ?? string.Empty,
+                City = user.City?.Name ?? string.Empty,
+                Profession = user.Profession,
+                IsOnline = user.ActiveStatus == "Active",
+                ActiveStatus = user.ActiveStatus,
+                IsVerified = user.IsVerified,
+                IsProfileLocked = user.IsProfileLocked,
+                Status = row == null ? "none" : RelativeStatus(row, myId),
+                IsFollowing = follows.Contains(user.Id),
+                MutualCompanionsCount = mine.Count(id => theirs[user.Id].Contains(id))
+            });
+        }
+        return Ok(result);
+    }
+
+    /// <summary>
+    /// One member as seen by the signed-in member — the same CompanionDto the
+    /// companions endpoints answer (relationship status, mutuals, About-me JSON), so
+    /// the website can open any profile exactly like the guest tour does. Privacy:
+    /// members who switched off their public profile answer 403; a profile that may
+    /// not be visited (WhoCanVisitProfile) answers only its identity cards; a locked
+    /// profile hides its About-me content from non-companions.
+    /// </summary>
+    [HttpGet("{userId:int}")]
+    public async Task<ActionResult<CompanionDto>> Get(int userId, CancellationToken cancellationToken)
+    {
+        var myId = User.GetUserId();
+        var user = await _db.Users.AsNoTracking()
+            .Include(u => u.Country).Include(u => u.City).Include(u => u.Settings)
+            .FirstOrDefaultAsync(u => u.Id == userId, cancellationToken);
+
+        // Pending (not yet registered) accounts are invisible to everybody else.
+        if (user == null || (user.Status != UserProfileStatus.Active && user.Id != myId))
+            return NotFound();
+
+        if (userId != myId && user.Settings?.PublicProfileEnabled == false)
+            return Forbid();
+
+        var dto = await ToCompanionDto(user, myId, cancellationToken);
+        return Ok(await ApplyVisitRulesAsync(dto, user, myId, cancellationToken));
+    }
+
+    /// <summary>Resolves the 20-digit public profile id used in profile URLs.</summary>
+    [HttpGet("uid/{uniqueId:length(20)}")]
+    public async Task<ActionResult<CompanionDto>> GetByUniqueId(string uniqueId, CancellationToken cancellationToken)
+    {
+        var myId = User.GetUserId();
+        var user = await _db.Users.AsNoTracking()
+            .Include(u => u.Country).Include(u => u.City).Include(u => u.Settings)
+            .FirstOrDefaultAsync(u => u.UniqueId == uniqueId, cancellationToken);
+
+        // A unique id nobody carries belongs to nobody — same answer as an unknown id.
+        if (user == null || (user.Status != UserProfileStatus.Active && user.Id != myId))
+            return NotFound();
+
+        if (user.Id != myId && user.Settings?.PublicProfileEnabled == false)
+            return Forbid();
+
+        var dto = await ToCompanionDto(user, myId, cancellationToken);
+        return Ok(await ApplyVisitRulesAsync(dto, user, myId, cancellationToken));
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    /// <summary>Applies WhoCanVisitProfile and the profile lock to a visitor's view.</summary>
+    private async Task<CompanionDto> ApplyVisitRulesAsync(
+        CompanionDto dto, UserProfile user, int myId, CancellationToken cancellationToken)
+    {
+        if (user.Id == myId)
+            return dto;
+
+        var connected = dto.Status == "connected";
+        var rule = user.Settings?.WhoCanVisitProfile ?? "everyone";
+        if (rule == "none" || (rule == "companions" && !connected))
+        {
+            // Not allowed to visit: identity cards only, presented as a locked profile —
+            // the website renders its locked shield with the companionship actions.
+            return new CompanionDto
+            {
+                Id = dto.Id,
+                UniqueId = dto.UniqueId,
+                FullName = dto.FullName,
+                ProfilePhotoUrl = dto.ProfilePhotoUrl,
+                Country = dto.Country,
+                City = dto.City,
+                Profession = dto.Profession,
+                IsOnline = dto.IsOnline,
+                Status = dto.Status,
+                IsFollowing = dto.IsFollowing,
+                IsVerified = dto.IsVerified,
+                IsProfileLocked = true
+            };
+        }
+
+        if (user.IsProfileLocked && !connected)
+        {
+            // Locked for non-companions: the About-me story stays private.
+            dto.Bio = null;
+            dto.AboutMe = null;
+            dto.AboutMeDetailsJson = null;
+        }
+        return dto;
+    }
+
+    private async Task<CompanionDto> ToCompanionDto(UserProfile user, int myId, CancellationToken cancellationToken)
+    {
+        var row = await FindPair(myId, user.Id, cancellationToken);
+        var mine = await ConnectedCompanionIds(myId, cancellationToken);
+        var theirs = await ConnectedCompanionIds(user.Id, cancellationToken);
+        var isFollowing = await _db.Follows.AsNoTracking()
+            .AnyAsync(f => f.FollowerId == myId && f.FolloweeId == user.Id, cancellationToken);
+
+        return new CompanionDto
+        {
+            Id = user.Id,
+            UniqueId = user.UniqueId ?? UserProfileStatus.GenerateUniqueId(user.Id),
+            FullName = user.FullName ?? string.Empty,
+            ProfilePhotoUrl = user.ProfilePhotoData != null
+                ? $"/api/profile/{user.Id}/photo"
+                : user.ProfilePhotoUrl ?? user.ExternalProfilePictureUrl ?? string.Empty,
+            CoverPhotoUrl = user.CoverPhotoData != null
+                ? $"/api/profile/{user.Id}/cover"
+                : user.CoverPhotoUrl,
+            Country = user.Country?.Name ?? string.Empty,
+            City = user.City?.Name ?? string.Empty,
+            Profession = user.Profession ?? string.Empty,
+            IsOnline = user.ActiveStatus == "Active",
+            MutualCompanionsCount = mine.Intersect(theirs).Count(),
+            Status = row == null ? "none" : RelativeStatus(row, myId),
+            Bio = user.AboutMe,
+            AboutMe = user.AboutMe,
+            AboutMeDetailsJson = user.AboutMeDetailsJson,
+            IsProfileLocked = user.IsProfileLocked,
+            ActiveStatus = user.ActiveStatus,
+            CustomStatusText = user.CustomStatusText,
+            IsVerified = user.IsVerified,
+            IsFollowing = isFollowing,
+            ConnectedCompanionIds = theirs
+        };
+    }
+
+    private static bool Matches(string? value, string needle)
+        => !string.IsNullOrWhiteSpace(value) &&
+           value.Contains(needle, StringComparison.OrdinalIgnoreCase);
+
+    private static string RelativeStatus(Companionship row, int myId)
+    {
+        if (row.Status == CompanionshipStatus.Connected)
+            return "connected";
+        return row.RequesterId == myId ? "pending_outgoing" : "pending_incoming";
+    }
+
+    private async Task<Companionship?> FindPair(int x, int y, CancellationToken cancellationToken)
+    {
+        var (a, b) = x < y ? (x, y) : (y, x);
+        return await _db.Companionships.AsNoTracking()
+            .FirstOrDefaultAsync(c => c.UserId == a && c.CompanionId == b, cancellationToken);
+    }
+
+    private async Task<List<int>> ConnectedCompanionIds(int userId, CancellationToken cancellationToken)
+        => await _db.Companionships.AsNoTracking()
+            .Where(c => c.Status == CompanionshipStatus.Connected && (c.UserId == userId || c.CompanionId == userId))
+            .Select(c => c.UserId == userId ? c.CompanionId : c.UserId)
+            .ToListAsync(cancellationToken);
+
+    private async Task<List<int>> BlockedIds(int userId, CancellationToken cancellationToken)
+        => await _db.BlockedUsers.AsNoTracking()
+            .Where(b => b.UserId == userId || b.BlockedUserId == userId)
+            .Select(b => b.UserId == userId ? b.BlockedUserId : b.UserId)
+            .ToListAsync(cancellationToken);
+}
