+/// <summary>
+/// One hit of the community member search (<c>GET /api/users/search</c>): the identity
+/// cards of the result plus its relationship to the signed-in member, so the search
+/// drop-down can show Connect / Request Sent / Connected and Follow / Following
+/// without a second round trip.
+/// </summary>
+public class UserSearchResultDto
+{
+    public int Id { get; set; }
+    public string UniqueId { get; set; } = string.Empty;
+    public string FullName { get; set; } = string.Empty;
+    public string ProfilePhotoUrl { get; set; } = string.Empty;
+    public string Country { get; set; } = string.Empty;
+    public string City { get; set; } = string.Empty;
+    public string? Profession { get; set; }
+    public bool IsOnline { get; set; }
+    public string? ActiveStatus { get; set; }
+    public bool IsVerified { get; set; }
+    public bool IsProfileLocked { get; set; }
+
+    /// <summary>Companionship with the signed-in member: "connected", "pending_outgoing", "pending_incoming" or "none".</summary>
+    public string Status { get; set; } = "none";
+
+    /// <summary>True when the signed-in member already follows this traveler.</summary>
+    public bool IsFollowing { get; set; }
+
+    public int MutualCompanionsCount { get; set; }
+}
