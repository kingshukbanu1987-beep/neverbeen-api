+namespace NeverBeen.API.Entities;
+
+/// <summary>
+/// Links a user to an external OAuth account (Google / Facebook / Microsoft).
+/// A user can sign in with any of the linked identities.
+/// </summary>
+[Table("ExternalIdentities")]
